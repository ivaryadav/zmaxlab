# Tracking + integrations. All VITE_* values are public (they ship in the browser bundle).
# Leave a value empty to disable that integration - the code no-ops cleanly.

VITE_SITE_URL=https://zmaxlab.site

# Google Analytics 4
VITE_GA4_ID=G-XXXXXXXXXX
# Google Ads: conversion ID (AW-XXXXXXXXX) + one conversion label per action
VITE_GADS_ID=
VITE_GADS_LEAD_LABEL=
VITE_GADS_BOOKING_LABEL=
# Meta Pixel ID (numbers only)
VITE_META_PIXEL_ID=
# Microsoft Clarity project ID
VITE_CLARITY_ID=

# Forms + booking
VITE_FORMSPREE_ID=your_formspree_form_id
VITE_CALENDLY_URL=https://calendly.com/zmaxlab/consultation
VITE_WHATSAPP_URL=https://wa.me/919451100556

# Set to "true" only while testing in GA4 DebugView
VITE_ANALYTICS_DEBUG=false
